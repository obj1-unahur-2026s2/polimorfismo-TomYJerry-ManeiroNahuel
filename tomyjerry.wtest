import tomYJerry.*
describe "Pruebas de Tom , Jerry y Nibbles" {

    test "Al inicio la velocidad maxima de Tom es 10" {
        assert.equals(10, tom.velocidadMaxima())
    }

    test "Si se come a Jerry la Velocidad Maxima pasa a ser 15.2"{
       tom.comer(jerry)
        assert.equals(15.2, tom.velocidadMaxima())
    }

    test " si tom corre 24 metros entonces su velocidad maxima pasa a ser 14"{
        tom.comer(jerry)
        tom.correr(24)
        assert.equals(14,tom.velocidadMaxima())
    }  
    test  "Si come a Nibbles, pasa a tener de velocidad máxima 18.7"{
        tom.comer(jerry)
        tom.correr(24)
        tom.comer(nibbles)
        assert.equals(18.7,tom.velocidadMaxima())
    }
    test "si Jerry cumple años,y luego Tom lo vuelve a comer,pasaría a tener 25.9"{
        tom.comer(jerry)
        tom.correr(24)
        tom.comer(nibbles)
        jerry.cumplirAnios()
        tom.comer(jerry)
        assert.equals(25.9,tom.velocidadMaxima())
    }
    test "si corre 38 metros su velocidad pasa a ser 24 "{
        tom.comer(jerry)
        tom.correr(24)
        tom.comer(nibbles)
        jerry.cumplirAnios()
        tom.comer(jerry)
        tom.correr(38)
        assert.equals(24,tom.velocidadMaxima())
    }
    test"el raton peres pesa 50 de inicial"{
        assert.equals(50, perez.peso())
    }
    test " el raton perez pasa a pesar 55 si se come un queso"{
        perez.comerQueso()
        assert.equals(55, perez.peso())
    }
    test " tom no puede alcanzar a un raton que esta fuera de distancia "{
        assert.notThat(tom.puedeCazar(120))
    }











}